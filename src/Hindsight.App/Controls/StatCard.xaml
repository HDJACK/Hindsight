<UserControl x:Class="Hindsight.App.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Hindsight.App.Controls">
    <ui:Card Padding="16,12" Margin="0,0,12,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="ValueText" Grid.Row="1" FontSize="26" FontWeight="SemiBold" Text="–" Margin="0,2,0,6" />
            <local:SparklineControl x:Name="Spark" Grid.Row="2" />
        </Grid>
    </ui:Card>
</UserControl>
