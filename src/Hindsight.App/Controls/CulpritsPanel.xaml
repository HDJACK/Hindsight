<UserControl x:Class="Hindsight.App.Controls.CulpritsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:Card Padding="12">
        <DockPanel>
            <TextBlock x:Name="Header" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                       Text="Click a second in the timeline to see what was running." />
            <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                      SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Rows_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Description}" />
                                <Style.Triggers>
                                    <!-- Without this an unknown description would pop an empty tooltip box. -->
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="70" />
                    <DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="70" />
                    <DataGridTextColumn Header="File I/O" Binding="{Binding FileIo}" Width="90" />
                    <DataGridTextColumn x:Name="ColNetwork" Header="Network" Binding="{Binding Network}" Width="90" />
                    <DataGridTextColumn x:Name="ColDiskPhysical" Header="Disk (phys)" Binding="{Binding DiskPhysical}" Width="90" />
                    <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="80" />
                    <DataGridTextColumn x:Name="ColPrivate" Header="Private" Binding="{Binding Private}" Width="80" />
                    <DataGridTextColumn x:Name="ColHandles" Header="Handles" Binding="{Binding Handles}" Width="70" />
                    <DataGridTextColumn x:Name="ColThreads" Header="Threads" Binding="{Binding Threads}" Width="70" />
                    <DataGridTextColumn x:Name="ColParentChain" Header="Parent chain" Binding="{Binding ParentChain}" Width="220" />
                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="110" />
                    <DataGridTextColumn x:Name="ColCommandLine" Header="Command line" Binding="{Binding CommandLine}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </ui:Card>
</UserControl>
