<UserControl x:Class="Hindsight.App.Controls.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Hindsight.App.Controls">
    <UserControl.Resources>
        <!-- Plain WPF ListViews are not themed by WPF-UI 4.3.0 (it styles ui:ListView only), so without this the
             rows would render in the system theme's dark text on the dark background. See AnalysisTabs.xaml. -->
        <Style x:Key="ThemedListViewItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="DeltaCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Worse}" Value="True">
                    <Setter Property="Foreground" Value="OrangeRed" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ValueCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <DataTemplate x:Key="AnomalySentence">
            <TextBlock Text="{Binding Sentence}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="RowTimelineA" Height="Auto" />
            <RowDefinition x:Name="RowTimelineB" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition x:Name="RowAnomalies" Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Header: one card per recording -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock x:Name="TitleA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaA" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SummaryA" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
            <ui:Card Grid.Column="1" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="TitleB" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaB" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SummaryB" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,0,0,4">
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" IsIndeterminate="True" Width="120" Height="4"
                         VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
            <TextBlock x:Name="BusyText" DockPanel.Dock="Left" VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Comparing…" />
            <TextBlock x:Name="IntervalNote" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="OrangeRed" />
        </DockPanel>

        <controls:TimelineControl x:Name="TimelineA" Grid.Row="2" MinHeight="160" Margin="0,0,0,4" />
        <controls:TimelineControl x:Name="TimelineB" Grid.Row="3" MinHeight="160" Margin="0,0,0,8" />

        <DockPanel Grid.Row="4" Margin="0,0,0,4">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="Metric" />
            <ComboBox x:Name="MetricPicker" DockPanel.Dock="Left" Width="160"
                      SelectionChanged="MetricPicker_SelectionChanged" />
            <TextBlock x:Name="DiffTruncated" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Δ is B minus A; red means B used more." />
        </DockPanel>

        <Grid Grid.Row="5">
            <DataGrid x:Name="DiffGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserSortColumns="True" GridLinesVisibility="None"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Process" Binding="{Binding Process}" SortMemberPath="Process" Width="260" />
                    <DataGridTextColumn Header="A" Binding="{Binding A}" SortMemberPath="ValueA" Width="140"
                                        ElementStyle="{StaticResource ValueCell}" />
                    <DataGridTextColumn Header="B" Binding="{Binding B}" SortMemberPath="ValueB" Width="140"
                                        ElementStyle="{StaticResource ValueCell}" />
                    <DataGridTextColumn Header="Δ" Binding="{Binding Delta}" SortMemberPath="AbsDelta" Width="*"
                                        ElementStyle="{StaticResource DeltaCell}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="DiffEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="No processes in either recording." />
        </Grid>

        <Grid x:Name="AnomalyPanel" Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock x:Name="AnomalyHeaderA" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4"
                           Text="Anomalies in A" />
                <Grid>
                    <ListView x:Name="AnomaliesA" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              ItemContainerStyle="{StaticResource ThemedListViewItem}"
                              SelectionChanged="AnomaliesA_SelectionChanged">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource UiGridViewColumnHeaderStyle}">
                                <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding Severity}" />
                                <GridViewColumn Header="Metric" Width="90" DisplayMemberBinding="{Binding Metric}" />
                                <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="Duration" Width="90" DisplayMemberBinding="{Binding Duration}" />
                                <GridViewColumn Header="What happened" Width="320"
                                                CellTemplate="{StaticResource AnomalySentence}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="AnomaliesEmptyA" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No anomalies found." />
                </Grid>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock x:Name="AnomalyHeaderB" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4"
                           Text="Anomalies in B" />
                <Grid>
                    <ListView x:Name="AnomaliesB" SelectionMode="Single" BorderThickness="0" Background="Transparent"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              ItemContainerStyle="{StaticResource ThemedListViewItem}"
                              SelectionChanged="AnomaliesB_SelectionChanged">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource UiGridViewColumnHeaderStyle}">
                                <GridViewColumn Header="Severity" Width="70" DisplayMemberBinding="{Binding Severity}" />
                                <GridViewColumn Header="Metric" Width="90" DisplayMemberBinding="{Binding Metric}" />
                                <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="Duration" Width="90" DisplayMemberBinding="{Binding Duration}" />
                                <GridViewColumn Header="What happened" Width="320"
                                                CellTemplate="{StaticResource AnomalySentence}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="AnomaliesEmptyB" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="No anomalies found." />
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
