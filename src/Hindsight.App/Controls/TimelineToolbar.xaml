<UserControl x:Class="Hindsight.App.Controls.TimelineToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <WrapPanel Orientation="Horizontal">
        <ui:Button Content="Fit" Icon="{ui:SymbolIcon FullScreenMaximize24}" Margin="8,0,0,4" Click="Fit_Click"
                   ToolTip="Show the whole timeline (F)" />
        <ToggleButton x:Name="FollowToggle" Content="Follow" Margin="8,0,0,4" Padding="11,5,11,5"
                      Visibility="Collapsed" Checked="Follow_Changed" Unchecked="Follow_Changed"
                      ToolTip="Keep the newest tick at the right edge" />
        <ui:Button Content="Use view as range" Icon="{ui:SymbolIcon Ruler24}" Margin="8,0,0,4"
                   Click="Range_Click" ToolTip="Use the visible time range as the analysis range" />
        <TextBlock x:Name="Hint" VerticalAlignment="Center" Margin="12,0,0,4"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Wheel: zoom · Drag: pan · Shift+drag: select range · Esc: clear range · Right-click marker: delete" />
    </WrapPanel>
</UserControl>
